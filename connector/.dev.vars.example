# Пример локальных секретов для `wrangler dev`.
# Скопируй в файл `.dev.vars` (он в .gitignore) и заполни своими значениями.
# Для боевого деплоя эти же значения задаются через `wrangler secret put`.

CONNECTOR_TOKEN="длинная-случайная-строка"
SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","...":"..."}'
